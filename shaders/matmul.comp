#version 450
// Tiled GEMM: C = A * B
// A: M x K,  B: K x N,  C: M x N (row-major)

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) readonly  buffer ABuf { float data[]; } A;
layout(set = 0, binding = 1) readonly  buffer BBuf { float data[]; } B;
layout(set = 0, binding = 2) writeonly buffer CBuf { float data[]; } C;

layout(push_constant) uniform PushConstants {
    uint M;  // rows of A / rows of C
    uint N;  // cols of B / cols of C
    uint K;  // cols of A / rows of B
} pc;

#define TILE 16

shared float tileA[TILE][TILE];
shared float tileB[TILE][TILE];

void main() {
    uint row = gl_WorkGroupID.y * TILE + gl_LocalInvocationID.y;
    uint col = gl_WorkGroupID.x * TILE + gl_LocalInvocationID.x;

    float acc = 0.0;
    uint numTiles = (pc.K + TILE - 1) / TILE;

    for (uint t = 0; t < numTiles; ++t) {
        uint aCol = t * TILE + gl_LocalInvocationID.x;
        uint bRow = t * TILE + gl_LocalInvocationID.y;

        tileA[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (row < pc.M && aCol < pc.K) ? A.data[row * pc.K + aCol] : 0.0;

        tileB[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (bRow < pc.K && col < pc.N) ? B.data[bRow * pc.N + col] : 0.0;

        barrier();

        for (uint k = 0; k < TILE; ++k)
            acc += tileA[gl_LocalInvocationID.y][k] * tileB[k][gl_LocalInvocationID.x];

        barrier();
    }

    if (row < pc.M && col < pc.N)
        C.data[row * pc.N + col] = acc;
}
